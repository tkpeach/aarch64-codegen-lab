{
  "name": "learning-checkpoint-editor",
  "displayName": "Learning Checkpoint Editor",
  "description": "Fill checkpoint HTML forms and save them as ordinary VS Code documents.",
  "version": "0.1.1",
  "publisher": "repofoundry-local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "repofoundry.learningCheckpoint",
        "displayName": "Learning Checkpoint",
        "selector": [{ "filenamePattern": "**/learning/checkpoints/*.html" }],
        "priority": "default"
      }
    ]
  }
}
